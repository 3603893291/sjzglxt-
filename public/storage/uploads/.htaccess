# v5.2.4：上传目录只存放静态图片，禁止任何脚本执行（数据包导入投毒防护的纵深防御层）。
# 数据包/上传通道已在 PHP 层做扩展名白名单（仅 jpg/png/gif/webp），此处兜底：
# 即使有可执行扩展名文件被其它途径放进来，也一律拒绝访问。
Options -ExecCGI -Indexes

<IfModule mod_mime.c>
  RemoveHandler .php .phtml .php3 .php4 .php5 .php7 .phar .pl .py .cgi .sh
  RemoveType .php .phtml .php3 .php4 .php5 .php7 .phar
</IfModule>

<FilesMatch "\.(?i:php|phtml|php\d+|phar|pl|py|cgi|sh|asp|aspx|jsp|svg|html|htm|js)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
  </IfModule>
</FilesMatch>
